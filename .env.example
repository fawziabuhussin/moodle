# Entilaka Moodle
# Copy this file to .env and fill in the Neon connection strings.
# On Vercel, set the same keys in Project → Settings → Environment Variables.

# Pooled connection used by the app on Vercel serverless (hostname contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection used by Prisma Migrate (hostname does NOT contain -pooler).
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Session signing secret. Use a long random string (32+ characters).
AUTH_SECRET="replace-with-a-long-random-string"

# Shared secret for the physical attendance machine (header: x-terminal-secret).
TERMINAL_SECRET="replace-with-the-attendance-machine-secret"

# IANA timezone used for the late-cutoff comparison and calendar dates.
APP_TIMEZONE="Asia/Jerusalem"

# Optional Apple Push Notification service (iOS App Store).
# Store the .p8 key as a single line with \n escapes.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID=""
APNS_PRIVATE_KEY=""
APNS_HOST="https://api.sandbox.push.apple.com"

# Optional Firebase Cloud Messaging server key (Android, web, or FCM-based iOS).
FCM_SERVER_KEY=""
